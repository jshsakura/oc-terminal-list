# OC Terminal List environment example
# 실제 사용 시 복사해서 수정하세요:
#   cp .env.example .env
#
# 원칙:
#   - host-native/systemd 운영에서는 절대 경로를 권장합니다.
#   - Docker Compose에서는 compose.yml의 기본값만으로도 실행됩니다.
#   - DB 파일과 vault key(.vault-key)는 반드시 함께 백업/복구하세요.

# -----------------------------------------------------------------------------
# Runtime mode examples
# -----------------------------------------------------------------------------
# Host-native 권장 예시:
#   DB_PATH=/var/lib/iterminallist/iterminallist.db
#   VAULT_KEY_PATH=/var/lib/iterminallist/.vault-key
#   WORKSPACE_ROOT=/srv/iterminallist/workspace
#
# Docker Compose 기본 예시(보통 compose.yml에 이미 지정됨):
#   DB_PATH=/app/data/iterminallist.db
#   VAULT_KEY_PATH=/app/data/.vault-key
#   WORKSPACE_ROOT=/workspace

# -----------------------------------------------------------------------------
# Server binding
# -----------------------------------------------------------------------------
# FastAPI/uvicorn 바인딩 주소
# - 0.0.0.0: 외부/프록시 접속 허용
# - 127.0.0.1: 로컬 reverse proxy 뒤에서만 노출
HOST=0.0.0.0

# 웹 서비스 포트
# Docker Compose도 이 값을 읽어서 host/container 포트를 함께 바꿉니다.
# 예: APP_PORT=9000 docker compose up -d
APP_PORT=38822

# 운영에서는 false 권장. 개발 중 backend/main.py 직접 실행 시 true도 가능.
# systemd 예시는 deploy/iterminallist.service에서 RELOAD=false를 명시합니다.
RELOAD=false

# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Data and workspace
# -----------------------------------------------------------------------------
# SQLite DB 파일 경로
DB_PATH=/var/lib/iterminallist/iterminallist.db

# Vault 마스터 키 파일 경로
# - SSH 비밀번호, private key passphrase, OTP secret 복호화에 필요합니다.
# - 미설정 시 프로젝트 루트의 data/.vault-key가 사용됩니다.
# - DB와 다른 시점/다른 키를 섞으면 기존 vault secret 복호화가 실패합니다.
VAULT_KEY_PATH=/var/lib/iterminallist/.vault-key

# 터미널 작업/파일 탐색 루트
# 이 경로 아래만 파일 브라우저에서 노출됩니다.
WORKSPACE_ROOT=/srv/iterminallist/workspace

# -----------------------------------------------------------------------------
# tmux
# -----------------------------------------------------------------------------
# 전용 tmux socket namespace (`tmux -L <name>`)로 앱 세션을 격리합니다.
TMUX_SOCKET_NAME=iterminallist-app

# tmux scrollback/history limit
TMUX_HISTORY_LIMIT=100000

# -----------------------------------------------------------------------------
# Local development helper variables
# -----------------------------------------------------------------------------
# run.py가 frontend 개발 서버 포트로 사용합니다.
FRONTEND_PORT=5173

# frontend/vite.config.js가 dev proxy 대상으로 사용합니다.
# production build/GHCR/systemd 정적 서빙에는 필요 없습니다.
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# Security notes / migration-only variables
# -----------------------------------------------------------------------------
# JWT 서명 키는 .env가 아니라 DB(system_config)에 자동 생성/저장됩니다.
# 회전:
#   .venv/bin/python backend/rotate_jwt.py --confirm
#
# 아래 변수들은 일반 운영에서 설정하지 마세요.
# - JWT_SECRET_KEY: legacy vault fallback 용도. 새 설치/일반 운영에서는 사용 금지.
# - OLD_JWT_SECRET_KEY: backend/migrate_vault.py 실행 시 기존 vault migration 용도.
# JWT_SECRET_KEY=
# OLD_JWT_SECRET_KEY=
