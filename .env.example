# iTerminaLlist 호스트 설치 환경 변수 예시
# 실제 사용 시 .env 파일로 복사하여 본인 환경에 맞게 수정
# cp .env.example .env

# 터미널 작업/파일 탐색 루트 (절대 경로)
WORKSPACE_ROOT=/path/to/your/workspace

# SQLite DB 파일 경로 (절대 경로)
DB_PATH=/path/to/iterminallist/data/iterminallist.db

# JWT 서명 키 (운영 환경에서는 반드시 강력한 값으로 교체)
JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# FastAPI 바인딩
HOST=0.0.0.0
APP_PORT=8000

# tmux 전용 소켓 이름 (`tmux -L <name>` 으로 격리)
TMUX_SOCKET_NAME=iterminallist
TMUX_HISTORY_LIMIT=100000

# 개발 시 코드 변경 자동 리로드 (true/false)
RELOAD=true

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
