# iTerminaLlist 환경 변수 설정 예시
# 실제 사용 시 .env 파일로 복사하여 사용하세요
# cp .env.example .env

# ===========================
# Docker 이미지 설정
# ===========================
DOCKER_IMAGE=jshsakura/oc-terminal-list:latest
APP_PORT=8000

# ===========================
# 백엔드 설정
# ===========================
# Database path (SQLite)
DB_PATH=/app/data/octerminallist.db
WORKSPACE_ROOT=/workspace
SHELL=/bin/bash

# Python 환경
PYTHONUNBUFFERED=1

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===========================
# 보안 설정
# ===========================
# JWT Secret (강력한 키로 변경 필수)
# JWT_SECRET_KEY=generate-your-own-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
