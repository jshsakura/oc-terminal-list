# Vault 마스터 키 (절대 커밋 금지)
data/.vault-key
backend/data/.vault-key

# JWT 서명 키 — vault key 와 동일 디렉토리에 저장됨 (2026-05-19~). 절대 커밋 금지.
data/.jwt-secret
backend/data/.jwt-secret

# data/ 디렉토리 전체 — DB / vault key / jwt key 등 secret 모음.
# 위 *.db / .vault-key / .jwt-secret 패턴으로 이미 커버되지만 디렉토리 자체도 명시.
data/
backend/data/

# 컨테이너 부팅 시 마운트되는 SSH 키 (절대 커밋 금지) — .gitkeep 은 dir 만 살림
secrets/*
!secrets/.gitkeep

# Claude
.claude/

# Sisyphus / agent runtime state
.sisyphus/

# Jupyter
.ipynb_checkpoints/

# Backup files
backup-*.tar.gz
.playwright-mcp/
opencode-resolve/

# Local screenshots / debug captures (may contain private UI data)
# 문서용 스크린샷은 docs/screenshots/ 에 커밋한다 — 여긴 임시 캡처만.
*.screenshot.png
*-current.png

# Local deployment helper (machine-specific service/user assumptions)
deploy/local-deploy.sh

# Handoff / 작업 인수인계 메모 — 세션 간 컨텍스트 전달용 작업 로그.
# 코드가 아니라 진행 상황 기록이므로 레포에는 커밋하지 않는다(항구적 문서는 docs/ 로).
handoff/

# 에이전트 런타임 상태 (opencode/omo). 세션 ID·타임스탬프뿐이라 소스가 아니고,
# 계속 바뀌어 작업트리를 영원히 더럽힌다. 과거 `git add -A` 로 3개가 쓸려 들어갔던 자리.
.omo/
