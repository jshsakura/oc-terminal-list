#!/usr/bin/env python3
"""itl — 이 기계의 tmux 팬 사이로 말을 옮긴다.

에이전트가 "옆에 2번한테 시켜" 를 하려면 상대 팬의 tmux 소켓과 pane id 를 알아야
하는데, 그건 보내는 쪽이 알 수 있는 값이 아니다. itl 이 그 한 겹이다 — **팬에게**
보내고, 어느 소켓의 어느 pane 인지는 여기서 알아낸다.

규칙 셋:

1. **설정이 아니라 탐색이다.** DB 도 설정 파일도 안 읽는다. 현재 tmux 서버를 직접
   물어 지금 실제로 있는 것만 답한다(tmux 밖에서는 이 사용자 소켓 전체). 앱 없이 돌고,
   이미 세 번 밟은 "설정과 현실이 어긋난다" 에 안 걸린다.
2. **한 기계 안이다.** 크리덴셜을 만들지도 읽지도 않고 네트워크를 열지도 않는다.
   기계를 넘는 전달은 이미 인증된 SSH 를 쥔 쪽(앱 백엔드)이 이 파일을 stdin 으로 밀어
   원격에서 한 번 실행하는 방식으로 한다(llm_usage/collect.py 와 같은 규칙).
3. **stdlib only, 단일 파일.** 위의 stdin 밀어넣기가 성립하려면 import 할 것이 없어야
   한다. 설치 0, 포트 0, 버전 드리프트 0.

  itl list                     현재 서버의 팬 (`list --all`은 기계 전체)
  itl doctor                   현재 팬·소켓·전송 열쇠 진단
  itl whoami                   지금 이 팬의 주소
  itl send <주소> <내용>        그 팬에 꽂는다 (`2.1` 이면 다른 기계여도 된다)
  itl read <주소>              그 팬의 최근 출력
  itl sandbox-config           현재 팬의 Codex 샌드박스 허용 설정 출력

⚠️ 보내는 내용은 **남이 준 값**일 수 있다. 키 이름으로 해석되지 않게 전 경로에서
리터럴로만 다룬다(tmux 버퍼 붙여넣기). 이걸 되돌리면 팬 하나가 남의 팬에 임의 키를
넣는 통로가 된다.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys

#: 어떤 조회도 여기서 더 기다리지 않는다 — 끝나지 않는 대기는 버그다.
TIMEOUT_SEC = 5.0

#: 한 번에 꽂을 수 있는 길이. 터미널 한 줄에 붙여넣는 것 이상은 이 도구의 일이 아니다.
MAX_TEXT_BYTES = 8192

TMUX = "tmux"


class ItlEnvironmentError(OSError):
    """A definitive environment failure that retrying cannot resolve."""

    error_code = "tmux_unavailable"


class TmuxAccessError(ItlEnvironmentError):
    """The current process cannot query a tmux socket."""

    error_code = "tmux_socket_denied"


class TmuxContextError(ItlEnvironmentError):
    """Inherited tmux identity does not identify a live sender pane."""

    error_code = "tmux_context_stale"


def report_environment_error(error: ItlEnvironmentError, *, as_json: bool,
                             request_id: str | None = None, handed_off: bool | None = None) -> int:
    """Report the cause once, preserving uncertain delivery after handoff."""
    result = {"ok": False, "errorCode": error.error_code, "retryable": False,
              "nextCommand": "itl sandbox-config" if isinstance(error, TmuxAccessError) else None,
              "error": str(error)}
    if request_id:
        result.update(requestId=request_id, delivery="failed" if handed_off is False else "unknown")
        if handed_off is not None:
            result["handedOff"] = handed_off
    hint = "; 권한 설정 확인: itl sandbox-config" if isinstance(error, TmuxAccessError) else ""
    print(json.dumps(result, ensure_ascii=False) if as_json else f"itl: {error}. 진단: itl doctor{hint}",
          file=sys.stdout if as_json else sys.stderr)
    return 4 if handed_off is True else 3


def stale_context_error() -> TmuxContextError:
    """Never guess a replacement for an inherited pane that no longer exists."""
    return TmuxContextError("현재 TMUX/TMUX_PANE이 살아 있는 팬을 가리키지 않는다. "
                            "앱에서 터미널을 다시 열고 새 셸에서 실행하라; 다른 팬 번호를 추측하지 마라")


def current_tmux_context() -> tuple[str, str, str] | None:
    """Validate exact pane membership before reading keys or changing sender options."""
    socket = (os.environ.get("TMUX") or "").split(",", 1)[0]
    pane = os.environ.get("TMUX_PANE") or ""
    if not socket and not pane:
        return None
    if not os.path.isabs(socket) or not re.fullmatch(r"%\d+", pane):
        raise stale_context_error()
    binary = tmux_bin()
    if not binary:
        raise ItlEnvironmentError("tmux 실행 파일이 없다 — 도구 메뉴에서 tmux를 설치하라")
    code, out, err = run([binary, "-S", socket, "list-panes", "-a", "-F", "#{pane_id}"])
    if code != 0:
        raise_if_tmux_denied(err, socket)
        raise ItlEnvironmentError(f"현재 tmux 서버에 연결할 수 없다: {err.strip() or code}. 터미널을 다시 열어라")
    if pane not in out.splitlines():
        raise stale_context_error()
    return binary, socket, pane


def raise_if_tmux_denied(err: str, socket: str) -> None:
    """Keep a denied socket distinct from an empty or stale tmux server."""
    if "operation not permitted" in err.lower() or "permission denied" in err.lower():
        raise TmuxAccessError(
            f"tmux 소켓 '{socket}' 접근 거부: {err.strip()}. "
            "이 실행 환경에서 소켓 접근을 허용해야 한다; 같은 셸에서 재시도해도 해결되지 않는다"
        )


def codex_sandbox_config(socket: str) -> str:
    """Return a socket-specific Codex permission profile without querying tmux."""
    parent = os.path.dirname(socket)
    return (f'default_permissions = "itl-tmux"\n\n'
            '[features]\nnetwork_proxy = true\n\n'
            '[permissions.itl-tmux]\nextends = ":workspace"\n\n'
            f'[permissions.itl-tmux.filesystem]\n{json.dumps(parent)} = "read"\n\n'
            '[permissions.itl-tmux.network]\nenabled = true\n\n'
            f'[permissions.itl-tmux.network.unix_sockets]\n{json.dumps(socket)} = "allow"')

#: 앱의 탭 주소(`탭.pane`). 이 모양은 **이 기계 밖일 수 있으므로** itl 이 직접 못 푼다 —
#: 앱 백엔드만이 어느 호스트의 어느 세션인지 안다. 그래서 표식 한 줄로 넘긴다.
APP_ADDR_RE = re.compile(r"^\d+\.\d+$")

#: 백엔드 브리지가 PTY 출력에서 줍는 표식(backend/itl_channel.py). 양쪽이 **같아야** 한다.
SEND_MARKER = "__ITL_SEND__"
#: Bytes that break a typed line (a line feed typed into a pane is Enter).
_CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")

#: tmux 가 들고 있는 이 팬의 앱 주소. 백엔드가 탭 상태가 바뀔 때마다 새긴다(pane_addr.py).
TMUX_ADDR_OPTION = "@pane_addr"

#: The pane's key for the marker channel (backend/itl_key.py). The backend stamps it on
#: tmux sessions as this user option and hands it to non-tmux panes as this env var.
#: A marker line without the right key is dropped by the bridge — that is what stops a
#: `cat`ed file or a `curl`ed page from typing into another pane.
TMUX_KEY_OPTION = "@itl_key"
KEY_ENV = "ITL_KEY"

#: 붙어 있지 않은 팬의 통로. 표식은 **브라우저가 붙어 있을 때만** 읽히는데(읽는 주체가
#: 그 WS 브리지다) 배경 에이전트는 대개 안 붙어 있다 — 그때 표식은 조용히 사라진다.
#: tmux 옵션은 붙어 있든 아니든 남고, 백엔드의 기존 1.5초 폴링이 같은 호출로 걷어 간다.
TMUX_OUTBOX_OPTION = "@itl_outbox"
TMUX_PENDING_OPTION = "@itl_pending"
RECEIPT_PREFIX = "@itl_receipt_"
REQUEST_ID_RE = re.compile(r"^[0-9a-f]{8,32}$")

# ─── 프로세스 실행 ────────────────────────────────────────────────────────────

def run(argv: list[str], *, timeout: float = TIMEOUT_SEC, input_text: str | None = None) -> tuple[int, str, str]:
    """(returncode, stdout, stderr). **던지지 않는다** — 없는 멀티플렉서는 흔한 상태다."""
    try:
        p = subprocess.run(
            argv, stdin=None if input_text is not None else subprocess.DEVNULL,
            input=input_text, capture_output=True,
            timeout=timeout, text=True, errors="replace",
        )
        return p.returncode, p.stdout or "", p.stderr or ""
    except (OSError, subprocess.SubprocessError) as e:
        return 127, "", str(e)


def tmux_bin() -> str | None:
    return shutil.which("tmux")


# ─── 에이전트 상태 — 하나의 어휘 ─────────────────────────────────────────────
#
# tmux 는 상태를 모른다(타이틀만 준다). 그래서 타이틀에서 판정한다.
#
# 판정 규칙은 stablyai/orca (MIT) `src/shared/agent-title-status.ts` 에서 왔고,
# 이 저장소에 이미 두 벌 있다(backend/agent_status.py · frontend/utils/agentTitle.js).
# ⚠️ 여기가 **세 번째 사본**이다. 단일 파일이어야 stdin 으로 밀 수 있으므로 import 를
# 못 한다. 대신 나머지 둘과 같은 규율을 진다 — 판정 케이스는 여전히
# `shared/agent-title-cases.json` 하나이고, tests/test_itl_cli.py 가 그 표로 이 사본을
# 검사한다. 표를 안 보고 여기만 고치면 같은 팬이 보는 각도에 따라 다른 상태가 된다.

WORKING, PERMISSION, IDLE = "working", "permission", "idle"

CLAUDE_IDLE = "\u2733"
GEMINI_WORKING = "\u2726"
GEMINI_SILENT_WORKING = "\u23f2"
GEMINI_IDLE = "\u25c7"
GEMINI_PERMISSION = "\u270b"
BRAILLE_RE = re.compile(r"[\u2800-\u28ff]")

#: 의도적으로 좁다 — `amp` 같은 짧은 이름을 넣으면 평범한 셸 타이틀이 에이전트로 둔갑한다.
AGENT_NAMES = (
    "claude", "openclaude", "codex", "copilot", "cursor", "gemini",
    "antigravity", "opencode", "aider", "grok", "devin", "droid", "hermes", "agy",
)
# 토큰 단위 매치. substring 이면 "android" ⊃ "droid", "~/codex/ready" ⊃ "codex" 가 전부 오탐.
_B, _BE = r"(?<![\w./\\-])", r"(?![\w./\\-])"
_AGENT_NAME_RE = re.compile(
    _B + "(?:" + "|".join(AGENT_NAMES) + r")(?:\.(?:exe|cmd|bat|ps1))?" + _BE, re.IGNORECASE)
_IDLE_RE = re.compile(r"(?<![\w./\\-])(ready|idle|done)(?![\w-])", re.IGNORECASE)
_WORKING_RE = re.compile(r"(?<![\w./\\-])(working|thinking|running)(?![\w-])", re.IGNORECASE)
_PERMISSION_WORDS = ("action required", "permission", "waiting")


def detect_status(title):
    """'working' | 'permission' | 'idle' | None.

    None 은 "에이전트가 아니다" 이지 "모르겠다" 가 아니다.
    """
    if not title:
        return None
    # 글리프가 가장 강한 증거다 — cwd·세션 텍스트보다 우선한다.
    if GEMINI_PERMISSION in title:
        return PERMISSION
    if GEMINI_WORKING in title or GEMINI_SILENT_WORKING in title:
        return WORKING
    if GEMINI_IDLE in title:
        return IDLE
    if title.startswith(CLAUDE_IDLE):
        return IDLE
    if BRAILLE_RE.search(title):
        return WORKING
    # 글리프가 없으면 에이전트 이름이 있어야만 상태를 논한다.
    if not _AGENT_NAME_RE.search(title):
        return None
    lowered = title.lower()
    if any(w in lowered for w in _PERMISSION_WORDS):
        return PERMISSION
    if _IDLE_RE.search(title):
        return IDLE
    if _WORKING_RE.search(title):
        return WORKING
    return IDLE          # 이름만 있고 상태어가 없다 — 떠 있지만 놀고 있다


def unify_status(mux_status, title):
    """타이틀 판정 → 하나의 어휘. 모르면 빈 문자열.

    `mux_status` 는 멀티플렉서가 상태를 직접 말해 주던 시절의 자리다. tmux 는 말해 주지
    않으므로 지금은 언제나 비어 있고, 시그니처만 남겨 둔다.
    """
    return detect_status(title) or ""


# ─── 팬 하나 ─────────────────────────────────────────────────────────────────

def pane_record(mux, socket, session, native_id, *, label="", agent="",
                status="", cwd="", title="") -> dict:
    """탐색 결과 한 줄.

    `native_id` 는 tmux 에게 다시 말할 때 쓰는 값이고(`%0`), `addr` 는 사람이 치는 값이다.
    `mux` 는 언제나 tmux 다 — 옛 `--json` 소비자가 이 칸을 읽으므로 남겨 둔다.
    """
    return {
        "mux": mux,
        "socket": socket,          # tmux 소켓 경로 (표시·진단용)
        "session": session,
        "native_id": native_id,
        "label": label,            # tmux 의 `0.1` 같은 사람용 위치
        "addr": f"{session}:{native_id}",
        "agent": agent,
        "status": status,
        "cwd": cwd,
        "title": title,
        # 앱의 탭 주소(`1.2`). 모르면 빈 문자열 — **모른다고 적는다.**
        "app_addr": "",
    }


# ─── tmux 탐색 ───────────────────────────────────────────────────────────────

def tmux_sockets(*, all_servers: bool = False) -> list[str]:
    """Current server by default; enumerate user sockets only outside tmux or explicitly.

    앱이 자기 소켓(`-L iterminallist-app`)을 쓰므로 기본 소켓만 보면 앱의 팬을 통째로
    놓친다 — 이 도구가 존재하는 이유의 절반이 그것이다.
    """
    current = (os.environ.get("TMUX") or "").split(",", 1)[0]
    if os.path.isabs(current) and not all_servers:
        return [current]
    base = os.path.join(os.environ.get("TMUX_TMPDIR") or "/tmp", f"tmux-{os.getuid()}")
    try:
        names = sorted(os.listdir(base))
    except PermissionError as exc:
        raise TmuxAccessError(f"tmux 소켓 디렉터리 '{base}' 접근 거부: {exc}") from exc
    except OSError:
        names = []
    sockets = [os.path.join(base, n) for n in names]
    if os.path.isabs(current) and current not in sockets:
        sockets.append(current)
    return sockets


TMUX_FORMAT = (
    "#{pane_id}\t#{session_name}\t#{window_index}.#{pane_index}"
    "\t#{pane_current_command}\t#{pane_current_path}\t#{pane_title}"
)


def parse_tmux_panes(raw: str, socket: str) -> list[dict]:
    """`list-panes -a -F TMUX_FORMAT` 출력 → 팬 목록.

    타이틀이 **마지막**이어야 한다 — 그 안의 탭 문자를 maxsplit 이 흡수한다.
    """
    out: list[dict] = []
    for line in (raw or "").splitlines():
        if not line.strip():
            continue
        parts = line.split("\t", 5)
        if len(parts) < 6:
            continue
        pane_id, session, label, command, cwd, title = parts
        out.append(pane_record(
            TMUX, socket, session, pane_id, label=label,
            # tmux 는 상태를 모른다 — 타이틀이 유일한 증거다(orca 규칙).
            agent=command, status=unify_status("", title), cwd=cwd, title=title,
        ))
    return out


def tmux_app_addr(binary: str, socket: str, session: str) -> str:
    """이 tmux 세션에 새겨진 앱 주소(`1.2`). 없으면 빈 문자열.

    백엔드가 탭 번호가 바뀔 수 있는 모든 순간에 `@pane_addr` 로 새긴다(pane_addr.py) —
    하단 상태바의 `[1.2]` 와 **같은 값**이다. 그래서 팬 안의 에이전트가 "나는 2.1 이다"
    라고 말할 수 있다.
    """
    code, out, err = run([binary, "-S", socket, "show-options", "-qv",
                           "-t", session, TMUX_ADDR_OPTION])
    if code != 0:
        raise_if_tmux_denied(err, socket)
    return out.strip() if code == 0 else ""


def discover_tmux(socket: str | None = None, *, all_servers: bool = False) -> list[dict]:
    binary = tmux_bin()
    if not binary:
        return []
    panes: list[dict] = []
    sockets = [socket] if socket else tmux_sockets(all_servers=True) if all_servers else tmux_sockets()
    for sock in sockets:
        code, out, err = run([binary, "-S", sock, "list-panes", "-a", "-F", TMUX_FORMAT])
        if code != 0:
            raise_if_tmux_denied(err, sock)
            current = (os.environ.get("TMUX") or "").split(",", 1)[0]
            if socket or (sock == current and not all_servers):
                raise ItlEnvironmentError(
                    f"선택한 tmux 서버에 연결할 수 없다: {err.strip() or code}. 터미널을 다시 열어라")
            continue          # 죽은 소켓 파일이 남아 있는 것은 흔하다
        found = parse_tmux_panes(out, sock)
        # 세션당 한 번만 묻는다 — 주소는 세션에 새겨져 있다.
        seen: dict[str, str] = {}
        for pane in found:
            sess = pane["session"]
            if sess not in seen:
                seen[sess] = tmux_app_addr(binary, sock, sess)
            pane["app_addr"] = seen[sess]
        panes.extend(found)
    return panes


def discover() -> list[dict]:
    """Panes in the current server, or all user servers outside tmux."""
    return discover_tmux()


# ─── 주소 풀기 ───────────────────────────────────────────────────────────────

def resolve(panes: list[dict], addr: str) -> tuple[dict | None, str]:
    """주소 → 팬 하나. 받는 모양은 셋이고 **모호하면 고르지 않는다.**

      `<세션>:<네이티브id>`  정확한 주소 (list 가 내는 값)
      `<세션>`              그 세션에 팬이 하나뿐일 때. 앱이 만드는 모양이 정확히 이것이다
      `<에이전트이름>`        살아있는 에이전트가 하나뿐일 때

    ⚠️ 여러 개에 맞으면 **에러다.** 하나를 골라 주면 "그 중 하나" 에 명령이 들어가고,
    잘못 들어간 것을 되돌릴 방법이 없다.
    """
    want = (addr or "").strip()
    if not want:
        return None, "빈 주소"

    # 앱 주소(`1.2`)를 이 기계에서 바로 풀 수 있으면 그렇게 한다. tmux 가 `@pane_addr` 로
    # 들고 있기 때문이다 — **백엔드도 브라우저도 없이** 옆 탭에 말을 걸 수 있다는 뜻이고,
    # 그게 자율로 도는 에이전트에게 필요한 유일한 모양이다.
    by_app = [p for p in panes if p.get("app_addr") and p["app_addr"] == want]
    if len(by_app) == 1:
        return by_app[0], ""
    if len(by_app) > 1:
        opts = ", ".join(p["addr"] for p in by_app)
        return None, f"앱 주소 '{want}' 가 여럿이다 — 하나를 고르라: {opts}"

    exact = [p for p in panes if p["addr"] == want]
    if len(exact) == 1:
        return exact[0], ""
    if len(exact) > 1:
        return None, f"주소가 여러 팬에 맞는다: {want}"

    by_session = [p for p in panes if p["session"] == want]
    if len(by_session) == 1:
        return by_session[0], ""
    if len(by_session) > 1:
        opts = ", ".join(p["addr"] for p in by_session)
        return None, f"세션 '{want}' 에 팬이 여럿이다 — 하나를 고르라: {opts}"

    by_agent = [p for p in panes if p["agent"] and p["agent"] == want]
    if len(by_agent) == 1:
        return by_agent[0], ""
    if len(by_agent) > 1:
        opts = ", ".join(p["addr"] for p in by_agent)
        return None, f"에이전트 '{want}' 가 여럿이다 — 하나를 고르라: {opts}"

    return None, f"그런 팬이 없다: {want}"


# ─── 꽂기 ────────────────────────────────────────────────────────────────────

def send_tmux(pane: dict, text: str, *, enter: bool) -> tuple[bool, str]:
    binary = tmux_bin()
    if not binary:
        return False, "tmux 가 없다"
    target = pane["native_id"]
    base = [binary, "-S", pane["socket"]]
    code, mode, err = run([*base, "display-message", "-p", "-t", target, "#{pane_in_mode}"])
    if code != 0:
        return False, err.strip() or f"pane state → {code}"
    if enter and mode.strip() == "1":
        code, _out, err = run([*base, "send-keys", "-X", "-t", target, "cancel"])
        if code != 0:
            return False, err.strip() or f"copy-mode cancel → {code}"
    buffer = "itl-" + secrets.token_hex(8)
    code, _out, err = run([*base, "load-buffer", "-b", buffer, "-"], input_text=text)
    if code != 0:
        return False, err.strip() or f"load-buffer → {code}"
    # Framing keeps a TUI's paste-burst heuristic from consuming Enter as a newline.
    # One tmux command queue keeps another sender out of the paste/Enter boundary.
    args = [*base, "paste-buffer", "-p", "-r", "-d", "-b", buffer, "-t", target]
    if enter:
        args += [";", "send-keys", "-t", target, "Enter"]
    code, _out, err = run(args)
    if code != 0:
        run([*base, "delete-buffer", "-b", buffer])
        return False, err.strip() or f"paste/Enter → {code}"
    return True, ""


def put_outbox(line: str) -> bool:
    """이 팬의 tmux 세션에 우편함을 세운다. tmux 가 아니면 조용히 False.

    🔐 표식보다 오히려 **더** 믿을 만한 통로다: 화면에 찍는 것은 그 팬을 지나가는 어떤
    출력이든 할 수 있지만, tmux 옵션을 세우려면 그 소켓에 닿아야 한다(같은 OS 사용자).
    """
    context = current_tmux_context()
    if context is None:
        return False
    binary, socket, pane = context
    payload = json.loads(line)
    request_id = payload["n"]
    if not REQUEST_ID_RE.fullmatch(request_id):
        return False
    target = shlex.quote(pane)
    pending = f"set-option -t {target} {TMUX_PENDING_OPTION} {request_id} ; " if payload.get("receipt") is True else ""
    command = (pending + f"set-option -t {target} {TMUX_OUTBOX_OPTION} {shlex.quote(line)} ; "
               f"display-message -p queued ; wait-for -S {shlex.quote('itl-outbox-' + pane)}")
    condition = f"#{{&&:#{{==:#{{{TMUX_PENDING_OPTION}}},}},#{{==:#{{{TMUX_OUTBOX_OPTION}}},}}}}"
    code, out, err = run([binary, "-S", socket, "if-shell", "-F", "-t", pane,
                            condition, command, "display-message -p busy"])
    if code != 0:
        raise_if_tmux_denied(err, socket)
        raise ItlEnvironmentError(f"전송 우편함 접근 실패: {err.strip() or code}")
    return code == 0 and out.strip() == "queued"


def send_app_addr(addr: str, text: str, *, submit: bool = True,
                  request_id: str | None = None, require_receipt: bool = False) -> tuple[bool, str]:
    """이 기계 밖일 수 있는 주소 — 표식 한 줄로 백엔드에 넘긴다.

    itl 은 여기서 **배달을 확인하지 못한다.** 크리덴셜이 없으니 그래야 맞고(그게 이
    설계의 전부다), 대신 실패하면 백엔드가 이 팬에 `[itl] … 못 보냈다` 를 꽂는다.
    ⚠️ 그러니 "성공" 이라고 말하지 않는다 — "넘겼다" 라고만 말한다.

    표식이 화면에 남는 것은 의도다. 스트림 중간에서 바이트를 들어내면 렌더가 깨지고,
    무엇이 나갔는지 사람이 보는 편이 정직하다.
    """
    if len(text.encode("utf-8", errors="replace")) > MAX_TEXT_BYTES:
        return False, f"내용이 너무 길다 (>{MAX_TEXT_BYTES}B)"
    key = my_key()
    if not key:
        # Without the key the bridge drops the line, so say so here instead of printing
        # a marker that goes nowhere. Panes the app did not open have no key.
        return False, (f"'{addr}'을(를) 로컬 팬에서 찾지 못했고 이 팬에는 전송 열쇠가 없다. "
                       "itl list로 대상 주소를, itl whoami로 현재 팬을 확인하라. "
                       "다른 기계의 탭이면 앱이 연 팬에서 실행하라. "
                       "현재 셸에서 같은 명령을 재시도해도 전달되지 않는다")
    # 개행이 있으면 표식 줄이 쪼개져 백엔드가 못 줍는다. JSON 이 알아서 이스케이프한다.
    # `n` is a per-send nonce: the bridge drops an identical line seen before (a `cat`ed
    # transcript would otherwise replay every send), and this keeps real repeats distinct.
    payload = {"to": addr, "text": text, "key": key, "n": request_id or secrets.token_hex(4)}
    if not submit:
        payload["submit"] = False
    if require_receipt:
        payload["receipt"] = True
    line = json.dumps(payload, ensure_ascii=False)
    # **두 통로로 같이 낸다.** 표식은 붙어 있을 때 즉시, 우편함은 안 붙어 있어도 1.5초
    # 안에. 같은 `n` 이라 백엔드가 접으므로 두 번 꽂히지 않는다.
    queued = put_outbox(line)
    if (require_receipt or os.environ.get("TMUX")) and not queued:
        return False, "전송 우편함에 처리 중인 요청이 있다; 기존 요청 ID를 itl receipt로 확인하고 재전송하지 마라"
    if not require_receipt:
        print(SEND_MARKER + " " + line, flush=True)
    return True, ""


def receipt(request_id: str, *, timeout: float = 0) -> tuple[str, str]:
    if not REQUEST_ID_RE.fullmatch(request_id):
        return "", "요청 ID가 올바르지 않다"
    context = current_tmux_context()
    if context is None:
        return "", "결과 확인은 요청을 보낸 tmux 팬에서 실행하라"
    binary, socket, pane = context
    base = [binary, "-S", socket]
    code, out, err = run([*base, "show-options", "-qv", "-t", pane, RECEIPT_PREFIX + request_id])
    if code != 0:
        raise_if_tmux_denied(err, socket)
        raise ItlEnvironmentError(f"전달 결과 조회 실패: {err.strip() or code}")
    if code == 0 and out.strip():
        return out.strip(), ""
    if timeout > 0:
        run([*base, "wait-for", "itl-receipt-" + request_id], timeout=timeout)
        code, out, err = run([*base, "show-options", "-qv", "-t", pane, RECEIPT_PREFIX + request_id])
        if code != 0:
            raise_if_tmux_denied(err, socket)
            raise ItlEnvironmentError(f"전달 결과 조회 실패: {err.strip() or code}")
        if code == 0 and out.strip():
            return out.strip(), ""
    return "", err.strip() or f"요청 {request_id} 결과 미확인; itl receipt {request_id}로 확인하라. 재전송하지 마라"


def record_receipt(pane: dict, request_id: str, text: str) -> tuple[bool, str]:
    if not REQUEST_ID_RE.fullmatch(request_id):
        return False, "요청 ID가 올바르지 않다"
    binary = tmux_bin()
    if not binary:
        return False, "tmux 가 없다"
    target = pane["native_id"]
    base = [binary, "-S", pane["socket"]]
    _code, previous, _err = run([*base, "show-options", "-qv", "-t", target, "@itl_receipt_ids"])
    history = [value for value in previous.split() if REQUEST_ID_RE.fullmatch(value) and value != request_id]
    history.append(request_id)
    clear = f"set-option -u -t {shlex.quote(target)} {TMUX_PENDING_OPTION}"
    condition = f"#{{==:#{{{TMUX_PENDING_OPTION}}},{request_id}}}"
    args = [*base, "set-option", "-t", target, RECEIPT_PREFIX + request_id, text,
            ";", "set-option", "-t", target, "@itl_receipt_ids", " ".join(history[-64:])]
    for stale in history[:-64]:
        args += [";", "set-option", "-u", "-t", target, RECEIPT_PREFIX + stale]
    args += [
        ";", "if-shell", "-F", "-t", target, condition, clear, "",
        ";", "wait-for", "-S", "itl-receipt-" + request_id,
    ]
    code, _out, err = run(args)
    return code == 0, err.strip()


def send(pane: dict, text: str, *, enter: bool = True) -> tuple[bool, str]:
    if len(text.encode("utf-8", errors="replace")) > MAX_TEXT_BYTES:
        return False, f"내용이 너무 길다 (>{MAX_TEXT_BYTES}B)"
    return send_tmux(pane, text, enter=enter)


# ─── 알리기 ──────────────────────────────────────────────────────────────────

def notify(pane: dict, text: str) -> tuple[bool, str]:
    """팬의 **화면**에 한 줄 찍는다 — 입력줄은 건드리지 않는다.

    ⚠️ `send` 로 통지를 보내면 엔터를 안 치는 한 그 글이 **입력줄에 쌓인다.** 실제로
    통지 서너 개가 한 줄로 이어붙어 사용자가 손으로 지워야 했다. 통지는 답을 요구하는
    말이 아니라 알림이므로 출력 쪽에 속한다.

    tmux 는 팬의 tty 경로를 알려 주므로 거기에 그대로 쓴다 — 프로그램이 찍은 것과 같은
    자리라 에이전트도 자기 화면에서 읽을 수 있다(상태바 `display-message` 는 못 읽는다).
    """
    if pane["mux"] != TMUX:
        return False, "tmux 팬이 아니다"
    binary = tmux_bin()
    if not binary:
        return False, "tmux 가 없다"
    code, out, err = run([binary, "-S", pane["socket"], "display-message", "-p",
                          "-t", pane["native_id"], "#{pane_tty}"])
    tty = (out or "").strip()
    if code != 0 or not tty:
        return False, (err.strip() or "pane_tty 를 못 읽었다")[:200]
    try:
        with open(tty, "w") as fh:
            fh.write("\r\n" + text + "\r\n")
    except OSError as e:
        return False, str(e)[:200]
    return True, ""


# ─── 읽기 ────────────────────────────────────────────────────────────────────

def read(pane: dict, lines: int) -> tuple[str, str]:
    binary = tmux_bin()
    if not binary:
        return "", "tmux 가 없다"
    code, out, err = run([binary, "-S", pane["socket"], "capture-pane", "-p",
                          "-t", pane["native_id"], "-S", f"-{max(lines, 1)}"])
    return (out, "") if code == 0 else ("", err.strip() or f"capture-pane → {code}")


# ─── 열쇠 ────────────────────────────────────────────────────────────────────

def my_key() -> str:
    """The key the backend gave this pane, or "" when this pane has none.

    Env first (a plain shell spawned by the bridge), then the tmux session option.
    tmux is asked through the socket in `$TMUX` and the pane in `$TMUX_PANE` — a pane
    option lookup with `-t <pane>` resolves to that pane's session.
    """
    env_key = (os.environ.get(KEY_ENV) or "").strip()
    if env_key:
        return env_key
    context = current_tmux_context()
    if context is None:
        return ""
    binary, socket, pane = context
    code, out, err = run([binary, "-S", socket, "show-options", "-qv", "-t", pane,
                           TMUX_KEY_OPTION])
    if code != 0:
        raise_if_tmux_denied(err, socket)
        raise ItlEnvironmentError(f"현재 팬의 전송 열쇠 조회 실패: {err.strip() or code}")
    return out.strip() if code == 0 else ""


def foreground_command(tty: str) -> list[str]:
    """Read argv only from a process in this terminal's foreground group."""
    code, out, _err = run(["ps", "-t", tty, "-o", "pid=,pgid=,tpgid="])
    if code != 0:
        return []
    for row in out.splitlines():
        fields = row.split()
        if len(fields) != 3 or fields[1] != fields[2] or not fields[0].isdigit():
            continue
        try:
            with open(f"/proc/{fields[0]}/cmdline", "rb") as process:
                argv = process.read(65536).split(b"\0")
        except OSError:
            continue
        return [arg.decode("utf-8", errors="replace") for arg in argv if arg]
    return []


def is_agent(pane: dict) -> bool:
    """Is an agent (not a bare shell) sitting in this pane?

    Decides whether a backend-mediated send may press Enter. Submitting into an agent is
    a prompt; submitting into a shell is a command — the second must stay a human act.
    """
    # ⚠️ Not the title. Any output can set a pane title (OSC 0/2), so a shell that
    # displayed a hostile page would read as "claude". `agent` is the foreground
    # *process name* (`pane_current_command`).
    command = pane.get("agent") or ""
    if _AGENT_NAME_RE.search(command):
        return True
    if command not in {"node", "bun", "deno"}:
        return False
    binary = tmux_bin()
    if not binary:
        return False
    code, tty, _err = run([binary, "-S", pane["socket"], "display-message", "-p",
                           "-t", pane["native_id"], "#{pane_tty}"])
    if code != 0 or not tty.strip():
        return False
    argv = foreground_command(tty.strip())
    if len(argv) < 2:
        return False
    script = argv[1].replace("\\", "/")
    return (bool(_AGENT_NAME_RE.fullmatch(os.path.basename(script)))
            or script.endswith(("/@anthropic-ai/claude-code/cli.js", "/@openai/codex/bin/codex.js")))


# ─── 나는 누구인가 ───────────────────────────────────────────────────────────

def whoami(panes: list[dict]) -> dict | None:
    """이 프로세스가 앉아 있는 팬. tmux 가 `TMUX` + `TMUX_PANE` 로 말해 준다."""
    t_pane = os.environ.get("TMUX_PANE")
    if t_pane:
        # Pane ids (`%0`) restart per tmux *server*; with the app's socket and the
        # default socket both alive, `%0` exists on each. `$TMUX` names the socket.
        t_socket = (os.environ.get("TMUX") or "").split(",", 1)[0]
        matches = [p for p in panes if p["mux"] == TMUX and p["native_id"] == t_pane
                   and (not t_socket or p["socket"] == t_socket)]
        if len(matches) == 1:
            return matches[0]
    return None


# ─── 화면 ────────────────────────────────────────────────────────────────────

def format_table(panes: list[dict], me: dict | None) -> str:
    if not panes:
        return "팬이 없다 — tmux 가 이 기계에서 안 돌고 있다."
    rows = [("", "TAB", "ADDR", "MUX", "AGENT", "STATUS", "CWD")]
    for p in panes:
        rows.append((
            "*" if me and p["addr"] == me["addr"] and p["mux"] == me["mux"] else "",
            # 앱의 탭 번호. 남에게 "나는 2.1 이다" 라고 말할 때 쓰는 값이다.
            p.get("app_addr") or "-",
            p["addr"], p["mux"], p["agent"] or "-", p["status"] or "-",
            p["cwd"] or "-",
        ))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    return "\n".join(
        "  ".join(cell.ljust(widths[i]) for i, cell in enumerate(row)).rstrip()
        for row in rows
    )


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="itl",
        description="이 기계의 tmux 팬 사이로 말을 옮긴다.",
    )
    ap.add_argument("--json", action="store_true", help="사람이 아니라 프로그램이 읽는 출력")
    ap.add_argument("--socket", help="대상 tmux 소켓을 명시적으로 선택 (명령 앞에 지정)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    listing = sub.add_parser("list", help="현재 tmux 서버의 팬 (tmux 밖에서는 이 기계 전체)")
    listing.add_argument("--all", action="store_true", help="다른 tmux 서버도 모두 탐색")
    sub.add_parser("whoami", help="지금 이 팬의 주소")
    sub.add_parser("doctor", help="현재 팬·tmux 접근 진단 (명령을 전송하지 않음)")
    sub.add_parser("sandbox-config", help="현재 팬의 Codex 샌드박스 소켓 허용 설정 출력")

    s = sub.add_parser("send", help="그 팬에 꽂는다")
    s.add_argument("addr")
    s.add_argument("text")
    s.add_argument("--no-enter", action="store_true", help="내용만 넣고 엔터는 사람이")
    s.add_argument("--enter-if-agent", action="store_true",
                   help="에이전트 팬이면 엔터, 맨 셸이면 내용만 (백엔드가 대신 보낼 때의 규칙)")
    s.add_argument("--wait", type=float, default=70, help="백엔드 전달 결과를 기다릴 초 (0이면 대기 없이 넘긴다)")
    # `--raw` used to skip a multiplexer-native "agent prompt" path. Kept as a no-op so an
    # installed older caller does not fail argument parsing.
    s.add_argument("--raw", action="store_true", help=argparse.SUPPRESS)

    n = sub.add_parser("notify", help="그 팬의 화면에 한 줄 (입력줄은 안 건드린다)")
    n.add_argument("addr")
    n.add_argument("text")

    r = sub.add_parser("read", help="그 팬의 최근 출력")
    r.add_argument("addr")
    r.add_argument("--lines", type=int, default=40)
    q = sub.add_parser("receipt", help="요청 ID의 전달 결과 확인")
    q.add_argument("request_id")
    q.add_argument("--wait", type=float, default=0)
    record = sub.add_parser("record-receipt", help=argparse.SUPPRESS)
    record.add_argument("addr")
    record.add_argument("request_id")
    record.add_argument("text")

    args = ap.parse_args(argv)
    if args.socket and not os.path.isabs(args.socket):
        ap.error("--socket에는 절대 경로를 지정하라")
    if args.cmd == "receipt":
        if args.socket:
            ap.error("receipt는 원래 보낸 팬의 결과를 확인한다; --socket을 지정하지 마라")
        try:
            out, error = receipt(args.request_id, timeout=max(0, min(args.wait, 90)))
        except ItlEnvironmentError as exc:
            return report_environment_error(exc, as_json=args.json, request_id=args.request_id)
        if out:
            print(out)
            return 0 if json.loads(out).get("ok") is True else 3
        print(json.dumps({"ok": False, "requestId": args.request_id, "delivery": "unknown", "error": error})
              if args.json else error, file=sys.stdout if args.json else sys.stderr)
        return 4
    if args.cmd == "sandbox-config":
        socket = args.socket or (os.environ.get("TMUX") or "").split(",", 1)[0]
        if not os.path.isabs(socket):
            why = "TMUX 소켓 경로가 없다 — 앱의 tmux 팬 안에서 실행하라"
            if args.json:
                print(json.dumps({"ok": False, "error": why}, ensure_ascii=False))
            else:
                print(f"itl: {why}", file=sys.stderr)
            return 2
        instructions = ("샌드박스 바깥의 호스트 셸에서 ~/.codex/config.toml에 아래 값을 병합하라. "
                        "기존 [features]가 있으면 "
                        "network_proxy를 그 표에 넣어라. 기존 sandbox_mode/sandbox_workspace_write 및 "
                        "실행 옵션 --sandbox/--yolo는 권한 프로필보다 우선하므로 제거하라. "
                        "새 Codex 세션에서 적용된다")
        config = codex_sandbox_config(socket)
        if args.json:
            print(json.dumps({"ok": True, "socket": socket, "config": config,
                              "instructions": instructions}, ensure_ascii=False))
        else:
            print(f"{instructions}\n\n{config}")
        return 0
    try:
        if args.socket or (args.cmd == "list" and args.all):
            panes = discover_tmux(args.socket, all_servers=args.cmd == "list" and args.all)
        else:
            panes = discover()
    except ItlEnvironmentError as exc:
        return report_environment_error(exc, as_json=args.json)

    if args.cmd == "doctor":
        if not tmux_bin():
            return report_environment_error(ItlEnvironmentError("tmux 실행 파일이 없다 — 도구 메뉴에서 설치하라"),
                                            as_json=args.json)
        me = whoami(panes)
        if (os.environ.get("TMUX") or os.environ.get("TMUX_PANE")) and me is None:
            return report_environment_error(stale_context_error(), as_json=args.json)
        try:
            has_key = bool(my_key())
        except ItlEnvironmentError as exc:
            return report_environment_error(exc, as_json=args.json)
        result = {"ok": True, "socket": args.socket or (os.environ.get("TMUX") or "").split(",", 1)[0] or None,
                  "sender": (me.get("app_addr") or me["addr"]) if me else None,
                  "senderKeyAvailable": has_key,
                  "targets": [p.get("app_addr") or p["addr"] for p in panes]}
        print(json.dumps(result, ensure_ascii=False) if args.json else
              f"itl: 진단 정상 · 현재 팬 {result['sender'] or 'tmux 밖'} · 전송 열쇠 {'있음' if has_key else '없음'}\n"
              + format_table(panes, me))
        return 0

    if args.cmd == "list":
        if args.json:
            print(json.dumps({"panes": panes}, ensure_ascii=False))
        else:
            print(format_table(panes, whoami(panes)))
        return 0

    if args.cmd == "whoami":
        me = whoami(panes)
        if me is None and (os.environ.get("TMUX") or os.environ.get("TMUX_PANE")):
            return report_environment_error(stale_context_error(), as_json=args.json)
        if args.json:
            print(json.dumps({"pane": me}, ensure_ascii=False))
        elif me:
            # 남에게 알려줄 값은 앱의 탭 번호다. 없으면(앱이 안 연 팬) 네이티브 주소로 떨어진다.
            print(me.get("app_addr") or me["addr"])
        else:
            print("여기는 tmux 안이 아니다", file=sys.stderr)
        return 0 if me else 1

    # 앱 주소(`1.2`)는 이 기계 밖일 수 있다. **먼저 이 기계에서 풀어 본다** — 풀리면
    # 백엔드도 브라우저도 필요 없다. 못 풀면 그때만 표식으로 백엔드에 넘긴다.
    _local_hit, _ = resolve(panes, args.addr) if APP_ADDR_RE.match(args.addr.strip()) else (None, "")
    if (args.cmd == "send" and APP_ADDR_RE.match(args.addr.strip()) and _local_hit is None
            and not any(p.get("app_addr") == args.addr.strip() for p in panes) and not args.socket):
        request_id = secrets.token_hex(8)
        waiting = args.wait > 0
        try:
            ok, why = send_app_addr(args.addr.strip(), args.text, submit=not args.no_enter,
                                    request_id=request_id, require_receipt=waiting)
        except ItlEnvironmentError as exc:
            return report_environment_error(exc, as_json=args.json, request_id=request_id, handed_off=False)
        if ok and waiting:
            try:
                out, why = receipt(request_id, timeout=min(args.wait, 90))
            except ItlEnvironmentError as exc:
                return report_environment_error(exc, as_json=args.json, request_id=request_id, handed_off=True)
            if out:
                result = json.loads(out)
                if args.json:
                    print(out)
                else:
                    labels = {"enter-sent": "입력·엔터 전달 확인", "typed": "입력만 전달 확인",
                              "failed": "전달 실패", "unknown": "전달 결과 미확인"}
                    label = labels.get(result["delivery"], "결과 미확인")
                    detail = f" · {result['error']}" if result.get("error") else ""
                    print(f"itl: {args.addr} · {label} · 요청 {request_id}{detail}")
                return 0 if result.get("ok") is True else 3
            result = {"ok": False, "handedOff": True, "requestId": request_id,
                      "delivery": "unknown", "retryable": False, "error": why}
            print(json.dumps(result, ensure_ascii=False) if args.json else f"itl: {why}",
                  file=sys.stdout if args.json else sys.stderr)
            return 4
        if args.json:
            result = {"ok": ok, "handedOff": ok, "requestId": request_id,
                      "delivery": "queued" if ok else "failed",
                      "enterSent": None, "error": why or None}
            print(json.dumps(result, ensure_ascii=False))
        elif not ok:
            print(f"itl: {why}", file=sys.stderr)
        return 0 if ok else 3

    pane, why = resolve(panes, args.addr)
    if not pane:
        # ⚠️ 실패는 반드시 말한다. 조용히 성공한 척하면 보낸 쪽은 상대가 받았다고 믿는다.
        if args.json:
            print(json.dumps({"ok": False, "error": why}, ensure_ascii=False))
        else:
            print(f"itl: {why}", file=sys.stderr)
        return 2

    if args.cmd == "notify":
        ok, err = notify(pane, args.text)
        if args.json:
            print(json.dumps({"ok": ok, "error": err or None}, ensure_ascii=False))
        elif not ok:
            print(f"itl: {err}", file=sys.stderr)
        return 0 if ok else 3
    if args.cmd == "record-receipt":
        ok, error = record_receipt(pane, args.request_id, args.text)
        if not ok:
            print(error, file=sys.stderr)
        return 0 if ok else 3

    if args.cmd == "read":
        text, err = read(pane, args.lines)
        if err:
            print(f"itl: {err}", file=sys.stderr)
            return 3
        print(json.dumps({"pane": pane, "text": text}, ensure_ascii=False) if args.json else text)
        return 0

    # Backend-mediated sends carry text that may have come from another machine.
    # Submitting it into an agent is a prompt; submitting it into a shell would run it.
    enter = not args.no_enter
    text = args.text
    if args.enter_if_agent:
        enter = enter and is_agent(pane)
        # Last hop of a backend-mediated send: a line feed typed into a pane *is* Enter,
        # so the "no Enter into a shell" rule has to hold for the bytes too.
        text = _CONTROL_RE.sub(" ", text)
    ok, err = send(pane, text, enter=enter)
    if args.json:
        print(json.dumps({"ok": ok, "pane": pane, "enterSent": bool(ok and enter),
                          "delivery": ("enter-sent" if enter else "typed") if ok else "failed",
                          "error": err or None}, ensure_ascii=False))
    elif not ok:
        print(f"itl: {err}", file=sys.stderr)
    else:
        print(f"itl: {args.addr} 입력 전달됨 · " + ("엔터 전송됨" if enter else "엔터 생략됨"))
    return 0 if ok else 3


if __name__ == "__main__":
    sys.exit(main())
