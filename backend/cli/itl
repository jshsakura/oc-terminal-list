#!/usr/bin/env python3
"""itl — 터미널끼리 명령을 주고받는다.

pane 안에서 도는 에이전트(또는 사람)가 다른 pane 에 프롬프트를 넣기 위한 도구.
표준 라이브러리만 쓴다 — 원격 호스트에 파일 하나만 복사하면 그대로 돈다.

자기가 누구인지는 환경변수로 안다. tmux 세션 생성 시 주입된다:
  ITL_API      백엔드 주소            (예: http://127.0.0.1:38822)
  ITL_TOKEN    이 세션의 인증 토큰
  ITL_SESSION  이 pane 의 세션 ID     — `itl send 3` 처럼 탭 생략 주소의 기준점

주소 체계는 `itl list` 가 그대로 보여준다:
  3        현재 탭의 3번        1.3      1번 탭의 3번
  @이름     그 탭의 활성 pane     @이름.2   그 탭의 2번
  @working @idle @permission   상태로
  @claude @codex …             돌고 있는 명령으로
  @all     전부
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

API = os.environ.get("ITL_API", "http://127.0.0.1:38822").rstrip("/")
TOKEN = os.environ.get("ITL_TOKEN", "")
SESSION = os.environ.get("ITL_SESSION", "")
TIMEOUT = 15


def _die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def _request(method, path, params=None, body=None):
    url = f"{API}{path}"
    if params:
        url += "?" + urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {TOKEN}")
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as res:
            return json.loads(res.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = json.loads(e.read().decode()).get("detail", "")
        except Exception:
            pass
        if e.code == 401:
            _die("인증 실패 — ITL_TOKEN 이 없거나 만료됐습니다. 터미널을 새로 열어보세요.")
        _die(f"오류 {e.code}: {detail or e.reason}")
    except urllib.error.URLError as e:
        _die(f"백엔드에 연결할 수 없습니다 ({API}): {e.reason}")


def cmd_list(args):
    if args.json:
        print(json.dumps(_request("GET", "/api/itl/targets",
                                  {"from_session": SESSION})["targets"],
                         ensure_ascii=False, indent=1))
        return
    print(_request("GET", "/api/itl/targets",
                   {"from_session": SESSION, "fmt": "table"})["table"])


def cmd_who(args):
    """이 pane 이 어느 주소인지 — 상대에게 알려줄 때 쓴다."""
    targets = _request("GET", "/api/itl/targets", {"from_session": SESSION})["targets"]
    me = next((t for t in targets if SESSION and SESSION in (t["sessionId"], t["tmuxSession"])), None)
    if not me:
        _die("이 터미널의 주소를 찾지 못했습니다 (ITL_SESSION 미설정이거나 탭 상태가 아직 저장되지 않음).")
    print(f"{me['addr']}  ({me['tabName']} #{me['paneIndex']})")


def cmd_resolve(args):
    matched = _request("GET", "/api/itl/resolve",
                       {"to": args.to, "from_session": SESSION})["matched"]
    if not matched:
        _die(f"'{args.to}' 에 해당하는 터미널이 없습니다. `itl list` 로 주소를 확인하세요.")
    for t in matched:
        print(f"{t['addr']}  {t['tabName']} #{t['paneIndex']}  {t['command'] or '-'}  {t['status'] or '-'}")


def cmd_send(args):
    text = args.text if args.text is not None else sys.stdin.read()
    if not text.strip():
        _die("보낼 내용이 비어 있습니다.")
    result = _request("POST", "/api/itl/send", body={
        "to": args.to, "text": text, "submit": args.submit, "from_session": SESSION,
    })
    for d in result["delivered"]:
        print(f"sent → {d['addr']}")
    for s in result["skipped"]:
        reason = {"remote-unsupported": "원격 pane 은 아직 지원 안 함",
                  "session-gone": "세션이 사라짐"}.get(s["reason"], s["reason"])
        print(f"skip   {s['addr']} ({reason})", file=sys.stderr)
    if not result["delivered"]:
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(
        prog="itl", description="터미널끼리 명령을 주고받는다.",
        epilog="주소: 3 | 1.3 | @탭이름 | @탭이름.2 | @working | @claude | @all",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_list = sub.add_parser("list", help="열려 있는 터미널과 그 주소")
    p_list.add_argument("--json", action="store_true")
    p_list.set_defaults(func=cmd_list)

    sub.add_parser("who", help="이 터미널의 주소").set_defaults(func=cmd_who)

    p_res = sub.add_parser("resolve", help="이 주소가 어디로 가는지 미리 보기")
    p_res.add_argument("to")
    p_res.set_defaults(func=cmd_resolve)

    p_send = sub.add_parser("send", help="다른 터미널에 입력 (기본은 엔터 없음)")
    p_send.add_argument("to")
    p_send.add_argument("text", nargs="?", help="생략하면 표준입력에서 읽는다")
    p_send.add_argument("--submit", action="store_true",
                        help="엔터까지 친다. 기본은 안 친다 — 대화형 앱 한가운데 "
                             "엔터가 들어가면 의도치 않게 실행된다")
    p_send.set_defaults(func=cmd_send)

    args = parser.parse_args()
    if not TOKEN:
        _die("ITL_TOKEN 이 없습니다. 이 도구는 앱이 만든 터미널 안에서만 동작합니다.")
    args.func(args)


if __name__ == "__main__":
    main()
