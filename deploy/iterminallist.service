[Unit]
Description=iTerminaLlist Backend (FastAPI/uvicorn)
Documentation=https://github.com/jshsakura/iTerminaLlist
After=network.target

# 짧은 시간 안에 반복 실패 시 진정시키기 (5분 안에 10회 초과면 멈춤)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple

User=ubuntu
Group=ubuntu

# 한글 로케일 (jupyter.service 와 동일)
Environment=LANG=ko_KR.UTF-8
Environment=LC_ALL=ko_KR.UTF-8

# .env 의 운영 설정 (HOST/APP_PORT/...) 로드 — 먼저
EnvironmentFile=/home/ubuntu/app/jupyterLab/notebooks/iTerminaLlist/.env

# 운영 환경 — 코드 변경 자동 리로드 끔 (.env 의 RELOAD 위로 덮어씀; 순서가 중요)
Environment=RELOAD=false

WorkingDirectory=/home/ubuntu/app/jupyterLab/notebooks/iTerminaLlist/backend

# [중요] 시작 직전 포트 점유 정리 — KillMode=process 탓에 옛 uvicorn 이 고아로
#   남아 포트(APP_PORT)를 계속 잡으면 새 인스턴스가 바인딩에 실패해 restart 가
#   조용히 깨진다. 그 포트를 잡은 프로세스(=이 백엔드뿐)만 TERM→KILL 로 정리한다.
#   포트 기반이라 cgroup 전체(tmux/claude 세션)는 건드리지 않는다. '-' 접두사 =
#   대상이 없을 때(정상 종료된 경우) 실패를 무시.
ExecStartPre=-/usr/bin/fuser -k -TERM ${APP_PORT}/tcp
ExecStartPre=-/bin/sh -c 'sleep 1; /usr/bin/fuser -k -KILL ${APP_PORT}/tcp; exit 0'
ExecStart=/home/ubuntu/app/jupyterLab/notebooks/iTerminaLlist/.venv/bin/python main.py

# 비정상 종료 시 5초 뒤 재시작
Restart=always
RestartSec=5

# 종료 시그널 — uvicorn 은 SIGTERM 으로 graceful
KillSignal=SIGTERM
TimeoutStopSec=15

# tmux 서버 보존 — 백엔드 재시작 시 로컬 세션이 유지되어야 한다.
#   기본 KillMode=control-group 이면 cgroup 전체에 SIGTERM 이 가서 이 서비스가 띄운
#   tmux 서버 (`-L iterminallist-app`) 까지 같이 죽음. process 모드로 두면
#   MainPID(uvicorn) 만 SIGTERM 받고 tmux 서버는 cgroup 에 그대로 살아남음.
#   다음 부팅에서 백엔드가 attach 만 다시 걸면 됨 (세션 ID 동일).
#   Sub-process leak 위험이 있긴 하지만, 본 서비스는 데몬화된 tmux 외에 장기 실행 자식 없음.
KillMode=process

# 로그 → journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iterminallist

# cgroup 메모리 캡은 두지 않는다.
#   KillMode=process 로 tmux 자식이 이 서비스의 cgroup 에 남기 때문에, Claude/MCP 등
#   사용자가 tmux 안에서 띄운 무거운 워크로드(4 × Claude ≈ 6GB 정상)가 모두 합산된다.
#   캡을 걸면 정상 워크로드까지 cgroup OOM 으로 한꺼번에 죽어버려 UX 가 더 나빠짐.
#   누수는 코드 레벨에서 차단 (host_manager 펌프 backpressure cap 등) 한다.

[Install]
WantedBy=multi-user.target
